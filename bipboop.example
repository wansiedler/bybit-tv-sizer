# my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=

# Source: the bot whose alerts you receive
SOURCE_CHAT=source_bot

# Users whose messages are relayed verbatim from any chat, comma-separated.
# Empty disables the feature.
WATCH_USERS=some_trader

# @your_bot token from @BotFather
BOT_TOKEN=

# Where the bot posts. Your own user id, or -100... for a group.
TARGET_CHAT_ID=
# Who may give the bot orders (/close, /stopall, /lev1 ...): your numeric
# user id. Defaults to TARGET_CHAT_ID, which is the same number in a private
# chat. A group target must set it, or every command is refused.
OWNER_ID=
# Where each stream goes when it is not to live with the trading. Empty
# leaves that stream in TARGET_CHAT_ID, which is where all of it has always
# been; an id (-100... for a group or channel) moves it there whole. What is
# left in TARGET_CHAT_ID is the account itself: entries, exits, the risk
# manager and the answers to commands.
#
# The bot has to be a member, and an admin to post in a channel. An id it
# cannot post to costs nothing — the message goes to TARGET_CHAT_ID instead,
# because a chat that can go quiet without saying so is exactly what the
# error reporting exists to prevent.
ALERTS_CHAT_ID=
ERRORS_CHAT_ID=
WATCHED_CHAT_ID=
DAILY_CHAT_ID=

# Telethon login store, without the .session suffix. Keep it inside session/
# so a desktop run and a Docker run share one login instead of drifting into
# two, one of which is unauthorized.
SESSION_NAME=session/lexx_relay

# Lifecycle notices (start/stop) through the bot. 0 to silence.
NOTIFY_LIFECYCLE=1
# Name used in those notices.
RELAY_NAME=bybit-tv-sizer

# Read alerts out loud on a Google Nest speaker. CAST_HOST is the speaker,
# TTS_HOST is this machine as the speaker sees it (a LAN address, never
# localhost — the speaker fetches the audio itself). 0 in SPEAK_ALERTS mutes it.
CAST_HOST=
TTS_HOST=
TTS_PORT=8422
SPEAK_ALERTS=1
# How loud the bot speaks, 0-100. Empty plays at whatever the device is set
# to, which is not a setting anyone controls: a Nest keeps its media volume
# apart from the assistant volume the buttons reach when nothing is playing,
# and the level wandered on its own all evening. Set, it is applied before
# each clip and left there — not restored, because restoring hands the dial
# back to whatever moves it next. What plays after also plays at this level.
SPEAK_VOLUME=

# Hours (local) during which alerts are read aloud, start-end, wrapping
# midnight. Telegram delivery is unaffected. Empty speaks around the clock.
SPEAK_HOURS=8-23
# Say "Relay up"/"Relay down" on the speaker as the relay starts and stops,
# at any hour — SPEAK_HOURS does not apply. 0 to mute.
SPEAK_LIFECYCLE=1

# Announce your own Bybit position changes (opened/closed/resized) through
# the bot and the speaker. Create the key with the Read permission ONLY —
# the relay never trades, and the key should not be able to either.
# Both empty disables the watcher.
BB_A_K=
BB_A_S=
# Seconds between polls of the private v5 API.
BYBIT_POLL=0.5
# Kline timeframe for every chart screenshot, in minutes.
CHART_INTERVAL=15
# Bars of context on a chart (max 3000; fetched in pages of 1000).
CHART_BARS=1800
# Timeframes a CLOSE chart is drawn on, in minutes, comma separated. Each is
# rendered and the lot is pasted into one wide picture — Telegram shows them
# side by side and the journal keeps its single screenshot column. Defaults
# to CHART_INTERVAL plus 4h.
CLOSE_INTERVALS=15,240
# The hard risk manager: a position with no stop, or with leverage above
# MAX_LEVERAGE, gets one warning and then a reduce-only market close.
# 1 = on, 0 = off. Needs a Trade-capable key to actually close.
RISK_GUARD=1
# Seconds a breach may live before the market close fires.
GUARD_GRACE_SEC=45
# A position entered by hand and never given a stop gets this one instead
# of being closed, as a percent of the wallet — the whole cost of stopping
# out, both fees included, exactly as RISK_PCT means it in the sizer. The
# grace still runs first, so your own stop always wins; this is only what
# happens when none arrives. 0 goes back to closing the position.
#
# Not to be confused with RISK_TRIM below: that one keeps the stop you drew
# and cuts the size down to it. This one keeps the size you took and places
# the stop that fits. A position with no stop has nothing to trim against.
GUARD_STOP_PCT=1
# Seconds the dead hand may take on the way out. Before the relay stops it
# gives every bare position a stop, because the guard is software and dies
# with the process while a stop on the position belongs to the exchange.
# The container's stop grace is 30s and the goodbye notice still has to go
# out after this, so keep it well under.
DEAD_HAND_SEC=12

# Auto-size the limit orders you draw on the TradingView chart so the
# entry-to-stop distance always risks RISK_PCT of equity (ported from
# bybit-tv-sizer; variable names and arming match it one to one). Runs
# whenever the API keys are present; DRY_RUN=1 keeps it harmless. Amending
# needs a Read+Trade key — never withdrawal.
# How stale a signed request may be when Bybit reads it, in milliseconds.
# Docker Desktop's clock stalls while the Mac sleeps and catches up after:
# ten seconds behind for thirteen minutes once, and every signed call came
# back 10002 against the old 5000. The window is the replay guard, so wider
# is not free — 20000 survives a nap without opening it far.
RECV_WINDOW=20000

# 1 = testnet, 0 = mainnet (separate keys!)
BYBIT_TESTNET=0
# 1 = only log the amend, 0 = actually send it
DRY_RUN=1
# percent of the wallet balance (unrealised PnL excluded) that a stop-out
# costs, fees included; the trimmer cuts positions back to the same figure
RISK_PCT=0.5
# Ceiling on the deposit that percent is taken from. 100000 means a 300k
# wallet still risks 1% of 100k per trade — positions stop growing with the
# account. 0 = no ceiling. The sizer, the trimmer and the risk warning all
# use it; the reports keep showing the real balance.
RISK_EQUITY_MAX=0
# The reward-to-risk that earns the full RISK_PCT. A limit order with a
# thinner RR (read off its take and stop) risks proportionally less: at 3,
# an RR 1.5 order risks half of RISK_PCT. Applied when the order is sized;
# nothing chases it after the fill. 0 = always RISK_PCT. An order without a
# take is unscaled.
RR_FULL_RISK=3
# The fees the sizing budgets for: the entry (maker limit) and the stop's
# market close (taker). Bybit derivatives non-VIP defaults.
MAKER_FEE=0.0002
TAKER_FEE=0.00055
# stop assumed when the order has none; 0 = skip such orders
FALLBACK_SL_PCT=0
# notional ceiling = equity * this
MAX_LEVERAGE=5
# e.g. BTCUSDT,ETHUSDT ; empty = every symbol
SYMBOLS=
CATEGORY=linear
SETTLE_COIN=USDT
ACCOUNT_TYPE=UNIFIED
POLL_SEC=0.5
# Passes the entry and stop must hold still before the quantity is rewritten
# (dragging a stop amends the order on every mouse step).
SETTLE_POLLS=2
# Warn (never act) when a limit order's or fresh position's reward-to-risk
# is below this, and when a fresh position's risk strays from RISK_PCT.
# 0 disables the RR check.
MIN_RR=2
# Scale out instead of one take (needs TP_MAKER=1 and a stop on the trade).
# The first rung stands TP_FREE in R from the entry, and its share is the one
# that pays for the whole trade: fill it and a stop-out afterwards costs
# nothing. Price and share are one choice, not two — nearer the entry needs a
# bigger slice, and at the entry it would be the whole position. TP_LADDER is
# where the rest sit, also in R; the position's own take always ends the
# ladder and carries the rounding. A rung within half an R of the take is
# dropped — two orders doing one order's work — and its share goes to the
# take. Empty TP_LADDER leaves the breakeven rung and the take; TP_FREE=0
# drops the breakeven rung; without a stop the exit stays one limit.
#   entry 100000, stop 99171, take 110000, 1 BTC ->
#   100829×53%  101658×12%  102487×12%  103316×12%  110000×12%
TP_FREE=1
TP_LADDER=2,3,4

# Maker takes: swap the position's market take-profit (taker fee) for a
# reduce-only limit at the same price (maker, less than half the fee).
# The catch: a touch-and-bounce can leave a resting limit unfilled where
# the market TP would have closed. The stop always stays a market order.
TP_MAKER=0

# A tenth of every winning trade, set aside for the mentor. The close notice
# carries a button with the figure; tapping it writes one `десятина` row into
# the journal and nothing else. No money moves, and the Bybit key stays
# without withdrawal rights. 0 takes the button away.
TITHE_PCT=10

# Announce your own TradingView alerts: point a TV alert's Webhook URL at
# POST /tv/<secret> on TV_PORT (via a tunnel or port-forward). The secret in
# the path is the only auth — make it long and random. Empty disables.
TV_WEBHOOK_SECRET=
TV_PORT=8423
# Host interface docker-compose publishes TV_PORT on. 127.0.0.1 suits a
# tunnel running on the same machine (cloudflared); a router port-forward
# needs 0.0.0.0.
TV_BIND=127.0.0.1

# Your own chart everywhere. A capture service on the Mac (tv_capture.py,
# started by com.bybit.tv-capture.plist) shoots the TradingView layout you
# actually trade from, and its pane is the picture on the entry notice, the
# close notice, /positions and the /status snapshot. The entry frame also
# waits in TV_SHOT_DIR until the trade closes, so the row carries both — the
# close in column G, the entry in Q.
#
# Empty disables the whole thing and every picture is the chart the bot
# draws itself, exactly as before. So does a Mac asleep, a signed-out
# profile or a symbol TradingView will not show: the drawn chart goes out
# and Telegram says which of those it was. It never attaches a blank or a
# frame of the wrong symbol.
#
# A shot costs seconds — see TV_SHOT_WAIT — and a notice waits for it.
#
# The same secret goes to both sides. It is the only thing guarding the
# service, so make it long and random.
TV_SHOT_SECRET=
# The saved layout to shoot, as its URL. Required: without it the service
# refuses to start rather than guess.
TV_SHOT_LAYOUT=
# Relay side: where the Mac is, seen from inside the container. Docker
# Desktop points host.docker.internal at the host's own loopback, so the
# service never has to listen on the LAN.
TV_SHOT_URL=http://host.docker.internal:8424
# Host side. Keep the bind on loopback.
TV_SHOT_PORT=8424
TV_SHOT_BIND=127.0.0.1
# The Chrome profile holding the TradingView session, and the DevTools port
# it is driven through. That port is the whole browser to anyone who reaches
# it — it stays on 127.0.0.1, and the service never proxies it.
TV_SHOT_PROFILE=~/.bybit-tv-sizer/tv-profile
TV_SHOT_CDP=http://127.0.0.1:9222
# A symbol your layout does not hold gets a pane driven to it for that one
# tab. TV_SHOT_EXCHANGE is the feed it is drawn from; TV_SHOT_INTERVAL is
# the timeframe, and empty means whatever TradingView last showed you for
# that symbol — which can be a weekly chart of a five-minute trade. Set it
# to "15" or "5" and every such frame reads the same.
TV_SHOT_EXCHANGE=BYBIT
TV_SHOT_INTERVAL=
# Bybit's SOLUSDT is TradingView's SOLUSDT.P on a perpetual.
TV_SHOT_SUFFIX=.P
# One pane, in pixels. Bigger reads better and costs more Drive.
TV_SHOT_WIDTH=760
TV_SHOT_HEIGHT=460
# Where an entry frame waits for its close. Inside the session volume, so a
# rebuild does not lose the trades that are open.
TV_SHOT_DIR=session/tv-entry
# How long the relay waits for a frame before giving up on it. A warm shot
# is 8-12s; a symbol the layout has to be driven to is about 20.
TV_SHOT_WAIT=40

# Trade journal: every closed trade lands as a row in a Google Sheet via a
# tiny Apps Script web app (see README). Both empty disables it. The secret
# must match the SECRET constant inside the script.
SHEETS_URL=
SHEETS_SECRET=
# The journal's sheet link, shown in the startup notice and by /links.
JOURNAL_URL=
# Public origin of the TV webhook (for the startup notice links).
TV_PUBLIC_URL=

# Alert when the external IP changes (Bybit whitelist would break).
# The same loop knocks on HTTPS_PROXY and shouts when the tunnel every
# Bybit call rides through stops answering.
IP_WATCH=1
IP_POLL_SEC=60
TUNNEL_TIMEOUT=5
# Telegram goes direct — only Bybit needs the fixed-IP tunnel. The relay
# appends CAST_HOST and TTS_HOST itself, so the speaker never waits on the
# tunnel; list any other LAN host you talk to here.
NO_PROXY=api.telegram.org
# Whether the sizer may ENLARGE an order that risks less than RISK_PCT.
# 0 makes the size you drew a ceiling: too big gets cut, too small is left
# alone. With a tight stop the arithmetic runs away fast — a 0.27% stop
# needs three deposits of notional to put 0.84% at risk, and an order drawn
# at 10,843$ came back at 87,652$. Correct, and not what the hand that drew
# it meant. 1 keeps both directions. 0 also makes RISK_PCT read as a cap:
# the "risk X% depo" warning then fires only when you are over it, because
# being under a ceiling is where a trade is supposed to sit.
RISK_GROW=1

# How RISK_PCT is divided between several entries into one idea, nearest to
# price first. "25,75" gives the pre-entry a quarter and the deeper add
# three quarters, whatever sizes were drawn — so the feeler stays alive and
# the zone gets the bulk. Fewer shares than orders repeats the last one.
# Empty scales the drawn sizes instead, keeping their proportions; a lone
# order always takes the whole budget either way.
ENTRY_SPLIT=

# Cut a position whose stop-risk overshoots RISK_PCT back down to it with
# a reduce-only market order. Exact: the only slack is the lot step. 1 = on.
RISK_TRIM=1

# Every ERROR the relay logs, forwarded to the chat. The journal stopped
# writing for five days and the only trace was a line in the container log,
# so silence is not the default. One message per distinct reason, and a cap
# so a storm cannot bury the chat.
NOTIFY_ERRORS=1
ERROR_REPEAT_SEC=900     # the same reason again, no sooner than this
ERROR_BURST=4            # at most this many in a window
ERROR_WINDOW_SEC=60      # the window the burst is counted over

# The day in one message, local time. Trades, win rate, PnL, commission,
# turnover and how much of it was taker — commission came to 59%% of three
# months of losses here while being mentioned nowhere. Empty disables it.
DAILY_REPORT_AT=23:30
