<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.lexx.relay</string>
    <!-- Container mode: launchd-start.sh clears stale colima vz.pid state
         left by an unclean shutdown, waits for colima's docker daemon (its
         own LaunchAgent, com.abiosoft.colima, starts it), then brings the
         relay container up. The container itself has restart: unless-stopped,
         so no KeepAlive: this job only needs to fire once per login.
         DOCKER_CONTEXT pins the colima daemon: Docker Desktop owns the
         /usr/local/bin/docker symlink and the default context, and without
         the pin this job would start a second relay in Desktop's daemon —
         two relays on one session is a Telegram 409. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>DOCKER_CONTEXT</key>
        <string>colima</string>
    </dict>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/me/lexx-relay/launchd-start.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/me/lexx-relay</string>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/me/Library/Logs/lexx-relay-launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/me/Library/Logs/lexx-relay-launchd.log</string>
</dict>
</plist>
