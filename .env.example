# my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=

# Source: the bot whose alerts you receive
SOURCE_CHAT=lexx_dra_bot

# Users whose messages are relayed verbatim from any chat, comma-separated.
# Empty disables the feature.
WATCH_USERS=aLexjjcrypt

# @asada3289_bot token from @BotFather
BOT_TOKEN=

# Where the bot posts. Your own user id, or -100... for a channel.
TARGET_CHAT_ID=

# Telethon login store, without the .session suffix. Keep it inside session/
# so a desktop run and a Docker run share one login instead of drifting into
# two, one of which is unauthorized.
SESSION_NAME=session/lexx_relay

# Lifecycle notices (start/stop) through the bot. 0 to silence.
NOTIFY_LIFECYCLE=1
# Name used in those notices.
RELAY_NAME=lexx-relay

# Read alerts out loud on a Google Nest speaker. CAST_HOST is the speaker,
# TTS_HOST is this machine as the speaker sees it (a LAN address, never
# localhost — the speaker fetches the audio itself). 0 in SPEAK_ALERTS mutes it.
CAST_HOST=
TTS_HOST=
TTS_PORT=8422
SPEAK_ALERTS=1
# Hours (local) during which alerts are read aloud, start-end, wrapping
# midnight. Telegram delivery is unaffected. Empty speaks around the clock.
SPEAK_HOURS=23-8
# Say "Relay up"/"Relay down" on the speaker as the relay starts and stops,
# at any hour — SPEAK_HOURS does not apply. 0 to mute.
SPEAK_LIFECYCLE=1
