# my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=

# Source: the bot whose alerts you receive
SOURCE_CHAT=source_bot

# Users whose messages are relayed verbatim from any chat, comma-separated.
# Empty disables the feature.
WATCH_USERS=some_trader

# @your_bot token from @BotFather
BOT_TOKEN=

# Where the bot posts. Your own user id, or -100... for a channel.
TARGET_CHAT_ID=

# Telethon login store, without the .session suffix. Keep it inside session/
# so a desktop run and a Docker run share one login instead of drifting into
# two, one of which is unauthorized.
SESSION_NAME=session/lexx_relay

# Lifecycle notices (start/stop) through the bot. 0 to silence.
NOTIFY_LIFECYCLE=1
# Name used in those notices.
RELAY_NAME=lexx-relay

# Read alerts out loud on a Google Nest speaker. CAST_HOST is the speaker,
# TTS_HOST is this machine as the speaker sees it (a LAN address, never
# localhost — the speaker fetches the audio itself). 0 in SPEAK_ALERTS mutes it.
CAST_HOST=
TTS_HOST=
TTS_PORT=8422
SPEAK_ALERTS=1
# Hours (local) during which alerts are read aloud, start-end, wrapping
# midnight. Telegram delivery is unaffected. Empty speaks around the clock.
SPEAK_HOURS=8-23
# Say "Relay up"/"Relay down" on the speaker as the relay starts and stops,
# at any hour — SPEAK_HOURS does not apply. 0 to mute.
SPEAK_LIFECYCLE=1

# Announce your own Bybit position changes (opened/closed/resized) through
# the bot and the speaker. Create the key with the Read permission ONLY —
# the relay never trades, and the key should not be able to either.
# Both empty disables the watcher.
BYBIT_API_KEY=
BYBIT_API_SECRET=
# Seconds between polls of the private v5 API.
BYBIT_POLL=10

# Auto-size the limit orders you draw on the TradingView chart so the
# entry-to-stop distance always risks RISK_PCT of equity (ported from
# bybit-tv-sizer). NEEDS a Read+Trade key (never withdrawal) and amends
# real orders — hence off by default, and dry-run even when on.
SIZER=0
DRY_RUN=1
RISK_PCT=0.5
# Stop distance assumed when the order carries none. 0 skips such orders.
FALLBACK_SL_PCT=0
# Notional ceiling, as a multiple of equity.
MAX_LEVERAGE=5
# Comma-separated allowlist, e.g. BTCUSDT,ETHUSDT. Empty = all symbols.
SIZER_SYMBOLS=
SIZER_POLL=3
# Passes the entry and stop must hold still before the quantity is rewritten
# (dragging a stop amends the order on every mouse step).
SETTLE_POLLS=2
